{
  "expo": {
    "name": "resQ",
    "slug": "resq",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
